// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// NextAuth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // For credentials authentication
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Dashboard tables
model Customer {
  id             String          @id @default(cuid())
  name           String
  email          String
  image_url      String
  invoices       Invoice[]
  paymentMethods PaymentMethod[]

  @@map("customers")
}

model Invoice {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  amount     Int
  status     InvoiceStatus @default(PENDING)
  date       DateTime
  dueDate    DateTime? @map("due_date")
  description String?
  notes      String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments   Payment[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model Revenue {
  month   String @id
  revenue Int

  @@map("revenue")
}

// Payment System Models
model Payment {
  id                String        @id @default(cuid())
  invoiceId         String        @map("invoice_id")
  amount            Int           // Amount in cents
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  paymentMethod     PaymentProvider @default(STRIPE)

  // Provider-specific IDs
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripeChargeId        String? @map("stripe_charge_id")
  paypalOrderId         String? @map("paypal_order_id")
  paypalCaptureId       String? @map("paypal_capture_id")

  // Payment details
  description       String?
  receiptEmail      String? @map("receipt_email")
  receiptUrl        String? @map("receipt_url")
  failureReason     String? @map("failure_reason")

  // Metadata
  metadata          Json?

  // Relationships
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  // Timestamps
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String       @map("payment_id")
  amount            Int          // Amount in cents
  currency          String       @default("USD")
  status            RefundStatus @default(PENDING)
  reason            String?

  // Provider-specific IDs
  stripeRefundId    String? @map("stripe_refund_id")
  paypalRefundId    String? @map("paypal_refund_id")

  // Metadata
  metadata          Json?

  // Relationships
  payment           Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Timestamps
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("refunds")
}

model PaymentMethod {
  id                String              @id @default(cuid())
  customerId        String              @map("customer_id")
  type              PaymentMethodType
  isDefault         Boolean             @default(false) @map("is_default")

  // Card details (for Stripe)
  cardLast4         String?             @map("card_last4")
  cardBrand         String?             @map("card_brand")
  cardExpMonth      Int?                @map("card_exp_month")
  cardExpYear       Int?                @map("card_exp_year")

  // Provider-specific IDs
  stripePaymentMethodId String?         @map("stripe_payment_method_id")
  paypalPaymentMethodId String?         @map("paypal_payment_method_id")

  // Metadata
  metadata          Json?

  // Relationships
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_ACTION
  REQUIRES_CONFIRMATION
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}